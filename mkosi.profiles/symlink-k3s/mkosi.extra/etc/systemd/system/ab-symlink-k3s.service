[Unit]
Description=Symlink K3s and container storage to persistent DATA partition
Documentation=file:///usr/local/libexec/ab-symlink-k3s
After=local-fs.target
# Must complete before k3s-install.service runs, so k3s writes state
# into the DATA partition. Ordering-only references to units that aren't
# shipped are silently ignored by systemd, so plain builds are unaffected.
Before=k3s-install.service k3s.service
ConditionPathExists=!/var/lib/ab-symlink-k3s/done

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=180s
ExecStart=/usr/local/libexec/ab-symlink-k3s
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target