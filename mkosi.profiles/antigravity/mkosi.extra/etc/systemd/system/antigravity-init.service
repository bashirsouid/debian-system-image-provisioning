[Unit]
Description=Install Antigravity suite (first-boot, idempotent)
Documentation=https://antigravity.google/download
After=network-online.target
Wants=network-online.target
ConditionPathExists=!/var/lib/antigravity/.ab-antigravity-installed

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/antigravity-init
