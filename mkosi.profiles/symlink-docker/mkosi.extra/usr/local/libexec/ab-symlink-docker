#!/usr/bin/env bash
# /usr/local/libexec/ab-symlink-docker
#
# Idempotent first-boot oneshot: symlink Docker storage to the persistent
# DATA partition (/mnt/data/docker). Migrates any baked-in content into
# the data dir before replacing the real directory with a symlink.
#
# Runs once per root slot (ConditionPathExists=!/var/lib/ab-symlink-docker/done).
# If /mnt/data is not yet a real mountpoint (e.g. still formatting or
# missing data disk), waits with bounded retries so the first boot
# succeeds cleanly instead of leaving a failed unit.

set -euo pipefail

DATA_ROOT=/mnt/data
MARKER_DIR=/var/lib/ab-symlink-docker
MAX_RETRIES=45   # 45 * 2s = 90s ceiling; covers slow mkfs on large volumes
RETRY_SLEEP=2

log() { printf '[ab-symlink-docker] %s\n' "$*"; }

# Wait for /mnt/data to become a real mountpoint (not just an automount stub).
# With x-systemd.automount the directory exists immediately but mounts on
# first access; if the underlying volume is still being formatted (mkfs),
# the first mkdir will fail. We retry the operation itself, which both
# triggers and absorbs the automount.
attempt=0
last_err=""
until mkdir -p -- "$DATA_ROOT/docker" 2>/dev/null; do
  attempt=$((attempt + 1))
  # Capture the real error for the final failure message
  if ! mkdir -p -- "$DATA_ROOT/docker" 2>&1; then
    last_err="$(mkdir -p -- "$DATA_ROOT/docker" 2>&1 || true)"
  fi
  if (( attempt > MAX_RETRIES )); then
    log "ERROR: $DATA_ROOT not available after $((MAX_RETRIES * RETRY_SLEEP))s; giving up"
    [[ -n "$last_err" ]] && log "Last error: $last_err"
    exit 1
  fi
  log "Waiting for DATA partition (attempt ${attempt}/${MAX_RETRIES})..."
  sleep "$RETRY_SLEEP"
done

# Ensure parent directory exists so ln -sfn works on a fresh image.
install -d -m 0755 /var/lib

# Adopt-and-link for Docker storage.
# If /var/lib/docker exists as a REAL directory (not a symlink), migrate
# its content into the data dir. cp -a --update=none copies only
# missing files without affecting exit status (coreutils >= 9.3),
# so baked seeds are adopted without clobbering evolved runtime state
# on later boots / A/B swaps.
mkdir -p -- "$DATA_ROOT/docker"
if [[ -d /var/lib/docker && ! -L /var/lib/docker ]]; then
  log "Adopting seed content from /var/lib/docker into $DATA_ROOT/docker"
  cp -a --update=none -- /var/lib/docker/. "$DATA_ROOT/docker"/
  rm -rf -- /var/lib/docker
fi

# Replace (or create) the symlink. ln -sfn is idempotent: if the
# target already exists as the correct symlink, it's a no-op; if it
# exists as a symlink, it's replaced. Real directories are already
# removed by the migration block above, so ln never sees a real dir.
ln -sfn -- "$DATA_ROOT/docker" /var/lib/docker

# Marker only on full success. If we reach here, symlink is in place.
install -d -m 0700 "$MARKER_DIR"
date -u +%Y-%m-%dT%H:%M:%SZ > "$MARKER_DIR/done"
log "Done: Docker storage -> $DATA_ROOT/docker"