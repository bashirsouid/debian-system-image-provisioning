[Unit]
Description=Symlink Docker storage to persistent DATA partition
Documentation=file:///usr/local/libexec/ab-symlink-docker
After=local-fs.target
# Must complete before docker.service starts, so container images/
# volumes are written to the DATA partition from the beginning.
# Ordering-only reference to a unit that isn't shipped is silently ignored.
Before=docker.service
ConditionPathExists=!/var/lib/ab-symlink-docker/done

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=180s
ExecStart=/usr/local/libexec/ab-symlink-docker
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target