[Unit]
Description=Render SeaweedFS S3 credentials Secret for k3s auto-deploy
Documentation=https://github.com/chrislusf/seaweedfs
# Runs after DATA partition is mounted and symlink-k3s has adopted
# any baked manifests, but BEFORE k3s-install.service/k3s.service so the
# rendered Secret is present when k3s first applies manifests.
After=local-fs.target ab-symlink-k3s.service
Before=k3s-install.service k3s.service
# No-op if credentials are not provided (the corresponding
# systemd unit on the image will silently not start).
ConditionPathExists=/etc/credstore/seaweedfs-s3-credentials.json

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/ab-k3s-seaweedfs-render-creds
# Best-effort: if rendering fails, next boot retries.
Restart=no

[Install]
WantedBy=multi-user.target
