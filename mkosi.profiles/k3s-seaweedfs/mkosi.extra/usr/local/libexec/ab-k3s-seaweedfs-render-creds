#!/usr/bin/env bash
# /usr/local/libexec/ab-k3s-seaweedfs-render-creds
#
# Reads S3 credentials from /etc/credstore/seaweedfs-s3-credentials.json and
# renders the k8s Secret manifest that k3s auto-deploys for SeaweedFS.
# Runs at first boot (and every boot) via ab-k3s-seaweedfs-creds.service.
# Idempotent: re-renders each boot so credential rotations propagate.
#
# Credential file format (matching kopia-s3-creds-* convention):
#   {"accessKeyId": "...", "secretAccessKey": "..."}

set -euo pipefail

CREDS_FILE="/etc/credstore/seaweedfs-s3-credentials.json"
MANIFEST_DIR="/var/lib/rancher/k3s/server/manifests"
MANIFEST_FILE="${MANIFEST_DIR}/seaweedfs-s3-config.yaml"

log() { printf '[ab-k3s-seaweedfs-render-creds] %s\n' "$*" >&2; }

# Ensure manifest directory exists (symlink-k3s should have created it via adoption)
install -d -m 0755 "${MANIFEST_DIR}"

# Read credentials
if ! [[ -r "${CREDS_FILE}" ]]; then
    log "WARN: ${CREDS_FILE} not readable; skipping render"
    exit 0
fi

access_key="$(jq -r '.accessKeyId // empty' "${CREDS_FILE}")"
secret_key="$(jq -r '.secretAccessKey // empty' "${CREDS_FILE}")"

if [[ -z "${access_key}" || -z "${secret_key}" ]]; then
    log "WARN: accessKeyId or secretAccessKey empty in ${CREDS_FILE}; skipping render"
    exit 0
fi

# Validate credentials: alphanumeric + hyphen + underscore only
# This prevents JSON/YAML injection from malformed vault values.
if ! [[ "${access_key}" =~ ^[A-Za-z0-9_-]+$ ]]; then
    log "ERROR: accessKeyId contains invalid characters; aborting render"
    exit 1
fi
if ! [[ "${secret_key}" =~ ^[A-Za-z0-9_-]+$ ]]; then
    log "ERROR: secretAccessKey contains invalid characters; aborting render"
    exit 1
fi

# Generate the Secret manifest with the real credentials
cat >"${MANIFEST_FILE}" <<EOF
# /var/lib/rancher/k3s/server/manifests/seaweedfs-s3-config.yaml
#
# AUTO-GENERATED by ab-k3s-seaweedfs-render-creds.
# DO NOT EDIT DIRECTLY. Edit the credential in the age vault and rebuild.
#
# Source credential: /etc/credstore/seaweedfs-s3-credentials.json

apiVersion: v1
kind: Secret
metadata:
  name: seaweedfs-s3-config
  labels:
    app: seaweedfs
type: Opaque
stringData:
  s3.json: |
    {
      "identities": [
        {
          "name": "admin",
          "credentials": [
            {
              "accessKey": "${access_key}",
              "secretKey": "${secret_key}"
            }
          ],
          "actions": ["Admin", "Read", "Write", "List"]
        }
      ]
    }
EOF

chmod 0600 "${MANIFEST_FILE}"
log "rendered ${MANIFEST_FILE} (accessKeyId length=${#access_key})"
